        // =====================================================================
        // ENGINEER CALCULATIONS & RENDERING
        // =====================================================================
        function calculateItemMetrics(item) {
            let unitMaterialCost = 0;
            const breakdown = [];

            (item.materials || []).forEach(m => {
                const matDef = appState.materials[m.matId];
                if (!matDef) return;
                const effectiveRate = m.rate * (1 + (m.waste || 0) / 100);
                const costPerUnit = effectiveRate * matDef.price;
                const totalQtyNeeded = effectiveRate * item.qty;
                const totalMatCost = totalQtyNeeded * matDef.price;

                unitMaterialCost += costPerUnit;
                breakdown.push({
                    matId: m.matId,
                    name: matDef.name,
                    unit: matDef.unit,
                    basePrice: matDef.price,
                    rate: m.rate,
                    waste: m.waste,
                    effectiveRate,
                    costPerUnit,
                    totalQtyNeeded,
                    totalMatCost
                });
            });

            const laborDef = appState.labor[item.laborId] || { name: "غير محدد", price: 0 };
            const prodRate = item.prodRate > 0 ? item.prodRate : 1;
            const unitLaborCost = laborDef.price / prodRate;
            const totalDaysNeeded = item.qty / prodRate;

            const directUnitCost = unitMaterialCost + unitLaborCost;
            const clientUnitPrice = directUnitCost * (1 + (item.profitPct || 0) / 100);
            const totalDirectCost = directUnitCost * item.qty;
            const totalClientPrice = clientUnitPrice * item.qty;

            return {
                unitMaterialCost,
                unitLaborCost,
                directUnitCost,
                clientUnitPrice,
                totalDirectCost,
                totalClientPrice,
                totalDaysNeeded,
                laborName: laborDef.name,
                laborDailyRate: laborDef.price,
                breakdown
            };
        }

