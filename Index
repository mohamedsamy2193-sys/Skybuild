        function recalcModalPreview() {
            if (!tempModalAnalysis) return;
            tempModalAnalysis.prodRate = parseFloat(document.getElementById('modal-prod-rate').value) || 1;
            tempModalAnalysis.laborId = document.getElementById('modal-labor-select').value;

            const metrics = calculateItemMetrics(tempModalAnalysis);

            document.getElementById('modal-est-days').textContent = `${formatNum(metrics.totalDaysNeeded, 2)} يوم عمل`;
            document.getElementById('modal-labor-unit-cost').textContent = `${formatMoney(metrics.unitLaborCost)} ج.م / ${tempModalAnalysis.unit}`;
            document.getElementById('modal-total-unit-cost').textContent = `${formatMoney(metrics.directUnitCost)} ج.م`;
            document.getElementById('modal-total-batch-cost').textContent = `${formatMoney(metrics.totalDirectCost)} ج.م`;

            metrics.breakdown.forEach((b, idx) => {
                const qtyCell = document.getElementById(`modal-row-total-qty-${idx}`);
                const costCell = document.getElementById(`modal-row-unit-cost-${idx}`);
                if (qtyCell) qtyCell.textContent = `${formatNum(b.totalQtyNeeded, 2)} ${b.unit}`;
                if (costCell) costCell.textContent = `${formatMoney(b.costPerUnit)} ج.م`;
            });
        }

