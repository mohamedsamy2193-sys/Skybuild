        function applyEstimateLinesToBOQ(est, clientName, location) {
            appState.meta.projectName = `تشطيب وحدة ${est.area} م² — ${est.tierTitle}`;
            appState.meta.clientName = clientName;
            appState.meta.location = location;
            document.getElementById('meta-project').value = appState.meta.projectName;
            document.getElementById('meta-client').value = clientName;
            document.getElementById('meta-location').value = location;

            appState.boqItems = [];
            (est.lines || []).forEach(line => {
                (line.boqMapping || []).forEach(map => {
                    if (map.qty > 0) {
                        const catItem = appState.catalog.find(c => c.id === map.catId);
                        if (catItem) {
                            appState.boqItems.push(createBOQInstance(catItem, map.qty));
                        }
                    }
                });
            });

            saveState();
            renderEngineerAll();
            switchEngTab('boq');
            showToast("تم تحويل بيانات الوحدة إلى مقايسة تفصيلية وحساب جميع الخامات!");
        }

        function deleteLead(leadId) {
            appState.leads = appState.leads.filter(l => l.id !== leadId);
