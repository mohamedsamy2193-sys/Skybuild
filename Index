<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyBuild for Design & Contracting | سكاي بيلد للتصميم والمقاولات</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Cairo, Tajawal & Plus Jakarta Sans for English Brand Mark -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <!-- SheetJS (xlsx) for Multi-Sheet Excel Export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'Tajawal', 'sans-serif'],
                        brand: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        obsidian: {
                            800: '#1F2937',
                            900: '#111827',
                            950: '#090D16',
                        },
                        silver: {
                            50: '#F9FAFB',
                            100: '#F3F4F6',
                            200: '#E5E7EB',
                            300: '#D1D5DB',
                            400: '#9CA3AF',
                        },
                        gold: {
                            500: '#D97706',
                            600: '#B45309',
                            700: '#92400E',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F3F4F6;
            color: #111827;
            font-family: 'Cairo', sans-serif;
        }

        /* Custom Range Slider Styling */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            height: 8px;
            background: #E5E7EB;
            border-radius: 999px;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #111827;
            border: 3px solid #D97706;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            transition: transform 0.15s ease;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.12);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #F3F4F6;
        }
        ::-webkit-scrollbar-thumb {
            background: #9CA3AF;
            border-radius: 4px;
        }

        /* Print Styles for Clean A4 Branded BOQ */
        @media print {
            body {
                background-color: #FFFFFF !important;
                color: #000000 !important;
                font-size: 10.5pt;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .print-container {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }
            table {
                width: 100% !important;
                border-collapse: collapse !important;
            }
            th, td {
                border: 1px solid #CBD5E1 !important;
                padding: 5px 7px !important;
            }
            th {
                background-color: #F3F4F6 !important;
                -webkit-print-color-adjust: exact;
            }
            input, textarea, select {
                border: none !important;
                background: transparent !important;
                padding: 0 !important;
                resize: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-obsidian-900 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 left-5 z-50 flex flex-col gap-2 no-print"></div>

    <!-- ===================================================================== -->
    <!-- UNIFIED ARCHITECTURAL HEADER (MATCHING SKYBUILD LOGO)                 -->
    <!-- ===================================================================== -->
    <header class="bg-white border-b border-silver-200 sticky top-0 z-40 shadow-xs">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-4">
            
            <!-- SkyBuild Inline SVG Logo & Brand Lockup -->
            <a href="#" onclick="switchAppMode('client'); return false;" class="flex items-center gap-3.5 group" dir="ltr">
                <!-- Circular SB Crescent Emblem SVG -->
                <svg class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="62" cy="60" r="50" fill="#F1F5F9"/>
                    <!-- Sleek Black Crescent Arc on Left -->
                    <path d="M 65 10 C 33 10 10 34 10 62 C 10 90 33 111 63 111 C 74 111 83 107 90 101 C 80 106 69 108 58 106 C 34 102 18 82 20 58 C 22 33 41 14 65 10 Z" fill="#0F172A"/>
                    <path d="M 68 104 C 46 108 26 93 23 71 C 21 54 30 37 45 29 C 33 39 27 54 29 69 C 32 88 49 102 68 104 Z" fill="#0F172A"/>
                    <!-- Bold Geometric SB -->
                    <text x="64" y="73" text-anchor="middle" fill="#0F172A" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="38" letter-spacing="-1.5">SB</text>
                </svg>

                <!-- Brand Typography Lockup -->
                <div class="flex flex-col text-left">
                    <div class="flex items-baseline leading-none">
                        <span class="font-brand italic font-extrabold text-2xl sm:text-3xl text-obsidian-950 tracking-tight">Sky</span>
                        <span class="font-brand font-bold text-2xl sm:text-3xl text-obsidian-950 tracking-tight relative pb-1">
                            Build
                            <!-- Signature Underline beneath Build -->
                            <span class="absolute bottom-0 left-0 right-0 h-[3px] bg-obsidian-950 rounded-full"></span>
                        </span>
                    </div>
                    <span class="font-brand font-semibold text-[10px] sm:text-xs text-slate-600 tracking-wider uppercase mt-1">
                        for Design &amp; Contracting
                    </span>
                </div>
            </a>

            <!-- Right Controls: Mode Switcher & Contact -->
            <div class="flex items-center gap-2.5 no-print">
                <!-- Client Mode Indicator / Button -->
                <button id="btn-mode-client" onclick="switchAppMode('client')" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-obsidian-900 text-white shadow-xs">
                    <i class="ph ph-house-line text-lg text-amber-400"></i>
                    <span>حاسبة العميل والمعاينة</span>
                </button>

                <!-- Engineer Mode Login / Active Button -->
                <button id="btn-mode-engineer" onclick="handleEngineerModeClick()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-silver-100 hover:bg-silver-200 text-obsidian-900 border border-silver-300">
                    <i id="engineer-lock-icon" class="ph ph-lock-key text-lg text-gold-600"></i>
                    <span id="engineer-btn-label">دخول المهندس</span>
                    <span id="leads-badge-header" class="hidden bg-gold-600 text-white text-[10px] px-1.5 py-0.5 rounded-full">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ===================================================================== -->
    <!-- MODE 1: CLIENT LANDING, QUICK ESTIMATOR & INSPECTION BOOKING          -->
    <!-- ===================================================================== -->
    <div id="view-client" class="flex-1">
        
        <!-- Architectural Hero Banner -->
        <section class="bg-gradient-to-bl from-obsidian-950 via-obsidian-900 to-slate-800 text-white py-10 sm:py-14 px-4 border-b border-slate-800 relative overflow-hidden">
            <!-- Subtle Geometric Grid Background -->
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>
            
            <div class="max-w-[1280px] mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4">
                    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 px-3.5 py-1.5 rounded-full text-xs font-semibold text-amber-300">
                        <i class="ph ph-compass-tool text-base"></i>
                        <span>سكاي بيلد للتصميم والمقاولات — تشطيب هندسي متكامل</span>
                    </div>
                    <h1 class="text-2xl sm:text-4xl font-extrabold leading-tight">
                        احسب تكلفة تشطيب وحدتك بدقة، واحجز <span class="text-amber-400">معاينة هندسية</span> الآن
                    </h1>
                    <p id="hero-bio-text" class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
                        نقدم في <strong class="text-white">SkyBuild</strong> حلول التصميم الداخلي والتشطيبات المتكاملة بأعلى معايير الجودة الهندسية، إشراف كامل على كافة البنود، وجداول زمنية واضحة بدون مفاجآت في التكلفة.
                    </p>
                    <div class="flex flex-wrap items-center gap-4 pt-2 text-xs text-slate-300">
                        <span class="flex items-center gap-1.5"><i class="ph ph-check-circle text-amber-400 text-base"></i> مقايسة تفصيلية شفافّة</span>
                        <span class="flex items-center gap-1.5"><i class="ph ph-check-circle text-amber-400 text-base"></i> خامات معتمدة فرز أول</span>
                        <span class="flex items-center gap-1.5"><i class="ph ph-check-circle text-amber-400 text-base"></i> إشراف هندسي يومي</span>
                    </div>
                </div>

                <!-- Quick Stats / Trust Card -->
                <div class="lg:col-span-5 bg-white/5 backdrop-blur-xs border border-white/10 rounded-2xl p-5 sm:p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">خطوات العمل مع SkyBuild</span>
                        <i class="ph ph-buildings text-2xl text-slate-400"></i>
                    </div>
                    <div class="space-y-3 text-xs sm:text-sm">
                        <div class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center shrink-0">1</span>
                            <p class="text-slate-200">حدد مساحة شقتك ومستوى التشطيب المطلوب للحصول على <strong class="text-white">مقايسة تقديرية فورية</strong>.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center shrink-0">2</span>
                            <p class="text-slate-200">أرسل بياناتك لحجز <strong class="text-white">معاينة الموقع ورفع المقاسات</strong> على الطبيعة.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center shrink-0">3</span>
                            <p class="text-slate-200">استلم المقايسة النهائية المعتمدة والجدول الزمني للتنفيذ والتسليم.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Interactive Estimator & Booking Workspace -->
        <main class="max-w-[1280px] mx-auto px-4 sm:px-6 py-8 space-y-8">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- LEFT / RIGHT COL (7 cols): Client Apartment Configuration -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <!-- Step 1: Apartment Specs -->
                    <div class="bg-white rounded-2xl border border-silver-200 p-5 sm:p-6 shadow-xs space-y-5">
                        <div class="flex items-center justify-between border-b border-silver-100 pb-3">
                            <h2 class="text-base sm:text-lg font-extrabold text-obsidian-900 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-obsidian-900 text-white text-xs flex items-center justify-center">1</span>
                                <span>بيانات ومساحة الوحدة</span>
                            </h2>
                            <span class="text-xs text-slate-500">حرّك المؤشر لتحديد المساحة</span>
                        </div>

                        <!-- Area Slider + Number Input -->
                        <div class="bg-silver-50 border border-silver-200 rounded-xl p-4 space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="text-sm font-bold text-obsidian-900">مساحة الشقة / الوحدة الإجمالية (م²)</label>
                                <div class="flex items-center gap-1.5">
                                    <input type="number" id="client-area-input" value="140" min="40" max="1000" oninput="syncAreaFromInput(this.value)" class="w-24 text-center bg-white border-2 border-obsidian-900 rounded-xl py-1.5 text-base font-extrabold text-obsidian-950">
                                    <span class="text-xs font-bold text-slate-600">م²</span>
                                </div>
                            </div>
                            <input type="range" id="client-area-slider" min="50" max="450" step="5" value="140" oninput="syncAreaFromSlider(this.value)" class="w-full">
                            <div class="flex justify-between text-[11px] text-slate-400 font-semibold">
                                <span>50 م² (استوديو)</span>
                                <span>150 م² (شقة متوسطة)</span>
                                <span>300 م² (دوبلكس)</span>
                                <span>450+ م² (فيلا)</span>
                            </div>
                        </div>

                        <!-- Current Condition & Rooms -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1.5">حالة الاستلام الحالية</label>
                                <select id="client-condition" onchange="calculateClientEstimate()" class="w-full bg-silver-50 border border-silver-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-bold text-obsidian-900 focus:outline-none focus:border-obsidian-900">
                                    <option value="red_brick">طوب أحمر (على المحارة)</option>
                                    <option value="semi_finished">نصف تشطيب (محارة وحلوق)</option>
                                    <option value="renovation">تجديد شقة قائمة (تكسير وإحلال)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1.5">عدد الحمامات</label>
                                <select id="client-bathrooms" onchange="calculateClientEstimate()" class="w-full bg-silver-50 border border-silver-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-bold text-obsidian-900 focus:outline-none focus:border-obsidian-900">
                                    <option value="1">1 حمام</option>
                                    <option value="2" selected>2 حمام</option>
                                    <option value="3">3 حمامات</option>
                                    <option value="4">4 حمامات أو أكثر</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1.5">عدد الغرف (نوم + ريسبشن)</label>
                                <select id="client-rooms" onchange="calculateClientEstimate()" class="w-full bg-silver-50 border border-silver-200 rounded-xl px-3 py-2.5 text-xs sm:text-sm font-bold text-obsidian-900 focus:outline-none focus:border-obsidian-900">
                                    <option value="3">غرفتين + ريسبشن</option>
                                    <option value="4" selected>3 غرف + ريسبشن</option>
                                    <option value="5">4 غرف + ريسبشن</option>
                                    <option value="6">5 غرف أو أكثر</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Finishing Tier Selection -->
                    <div class="bg-white rounded-2xl border border-silver-200 p-5 sm:p-6 shadow-xs space-y-4">
                        <div class="border-b border-silver-100 pb-3">
                            <h2 class="text-base sm:text-lg font-extrabold text-obsidian-900 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-obsidian-900 text-white text-xs flex items-center justify-center">2</span>
                                <span>اختر باقة ومستوى التشطيب المطلوب</span>
                            </h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="tier-cards-container">
                            <!-- Tier Cards Rendered Dynamically -->
                        </div>
                    </div>

                    <!-- Step 3: Toggle Specific Trades / Packages -->
                    <div class="bg-white rounded-2xl border border-silver-200 p-5 sm:p-6 shadow-xs space-y-4">
                        <div class="flex items-center justify-between border-b border-silver-100 pb-3">
                            <h2 class="text-base sm:text-lg font-extrabold text-obsidian-900 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-obsidian-900 text-white text-xs flex items-center justify-center">3</span>
                                <span>البنود المشمولة في المقايسة</span>
                            </h2>
                            <span class="text-xs text-slate-500">يمكنك إلغاء أي بند غير مطلوب</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="client-packages-toggles">
                            <!-- Package checkboxes rendered dynamically -->
                        </div>
                    </div>

                </div>

                <!-- RIGHT / LEFT COL (5 cols): Live Estimated BOQ & Inspection Booking Form -->
                <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
                    
                    <!-- Live Cost Summary Card -->
                    <div class="bg-obsidian-950 text-white rounded-2xl p-6 shadow-lg border border-slate-800 space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div>
                                <span class="text-xs text-amber-400 font-bold">المقايسة التقديرية المبدئية</span>
                                <h3 class="text-lg font-extrabold mt-0.5" id="est-tier-label">باقة سوبر لوكس (Super Lux)</h3>
                            </div>
                            <button onclick="window.print()" class="bg-white/10 hover:bg-white/20 text-white p-2 rounded-xl text-xs flex items-center gap-1 transition no-print" title="طباعة المقايسة التقديرية">
                                <i class="ph ph-printer text-lg"></i>
                            </button>
                        </div>

                        <!-- Main Cost Figure -->
                        <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center space-y-1">
                            <p class="text-xs text-slate-400">التكلفة التقديرية الإجمالية (توريد وتركيب وإشراف)</p>
                            <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 tracking-tight" id="est-total-range">
                                0 — 0 ج.م
                            </div>
                            <p class="text-xs text-slate-300 pt-1">
                                متوسط سعر المتر المسطح: <strong class="text-white" id="est-per-sqm">0 ج.م / م²</strong>
                            </p>
                        </div>

                        <!-- Duration & Breakdown Mini Table -->
                        <div class="grid grid-cols-2 gap-3 text-center">
                            <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                <span class="text-[11px] text-slate-400 block">المدة الزمنية المتوقعة</span>
                                <span class="text-sm font-extrabold text-white mt-0.5 block" id="est-duration">45 - 60 يوم</span>
                            </div>
                            <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                <span class="text-[11px] text-slate-400 block">إجمالي البنود المختارة</span>
                                <span class="text-sm font-extrabold text-white mt-0.5 block" id="est-active-count">6 بنود رئيسية</span>
                            </div>
                        </div>

                        <!-- Itemized Preliminary Table -->
                        <div class="border border-slate-800 rounded-xl overflow-hidden">
                            <table class="w-full text-right text-xs">
                                <thead class="bg-slate-900 text-slate-300 border-b border-slate-800">
                                    <tr>
                                        <th class="py-2 px-3">البند</th>
                                        <th class="py-2 px-2 text-center">الكمية التقريبية</th>
                                        <th class="py-2 px-3 text-left">التكلفة التقديرية</th>
                                    </tr>
                                </thead>
                                <tbody id="client-est-tbody" class="divide-y divide-slate-800/80 text-slate-200">
                                </tbody>
                            </table>
                        </div>

                        <p class="text-[11px] text-slate-400 leading-relaxed">
                            * هذه المقايسة استرشادية بناءً على متوسطات الأسعار الهندسية الحالية، ويتم تحديد السعر النهائي الدقيق بعد رفع المقاسات ومعاينة الوحدة على الطبيعة.
                        </p>
                    </div>

                    <!-- Inspection Request Form Card -->
                    <div class="bg-white rounded-2xl border-2 border-obsidian-900 p-5 sm:p-6 shadow-md space-y-4 no-print">
                        <div class="flex items-center gap-2.5 border-b border-silver-100 pb-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-gold-600 flex items-center justify-center shrink-0">
                                <i class="ph ph-calendar-check text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-base font-extrabold text-obsidian-950">اطلب معاينة هندسية الآن</h3>
                                <p class="text-xs text-slate-500">سيتم إرفاق تفاصيل مقاومتك التقديرية تلقائياً مع الطلب</p>
                            </div>
                        </div>

                        <form id="inspection-form" onsubmit="submitInspectionRequest(event)" class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">الاسم بالكامل *</label>
                                <input type="text" id="lead-name" required placeholder="مثال: م. أحمد حسن" class="w-full bg-silver-50 border border-silver-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-obsidian-900 focus:bg-white">
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">رقم الموبايل / واتساب *</label>
                                    <input type="tel" id="lead-phone" required placeholder="010xxxxxxxx" class="w-full bg-silver-50 border border-silver-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-obsidian-900 focus:bg-white">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">المنطقة / الكمبوند *</label>
                                    <input type="text" id="lead-location" required placeholder="مثال: التجمع / الشيخ زايد" class="w-full bg-silver-50 border border-silver-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-obsidian-900 focus:bg-white">
                                </div>
                            </div>

                            <div>
