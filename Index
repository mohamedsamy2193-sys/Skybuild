        // =====================================================================
        // EXCEL EXPORT (MULTI-SHEET RTL XLSX)
        // =====================================================================
        function exportToExcel() {
            if (typeof XLSX === 'undefined') {
                showToast("جاري تحميل مكتبة الإكسيل...", "error");
                return;
            }

            const wb = XLSX.utils.book_new();
            wb.Workbook = { Views: [{ RTL: true }] };

            // Sheet 1: BOQ
            const boqRows = [
                ["SkyBuild for Design & Contracting — سكاي بيلد للتصميم والمقاولات"],
                ["المقايسة التقديرية لأعمال التشطيبات المعمارية"],
                ["المشروع:", appState.meta.projectName, "", "العميل:", appState.meta.clientName],
                ["الموقع:", appState.meta.location, "", "التاريخ:", appState.meta.date],
                [],
                ["م", "الفئة", "بيان الأعمال والمواصفات الفنية", "الوحدة", "الكمية", "التكلفة المباشرة للوحدة", "إشراف %", "فئة السعر للعميل (ج.م)", "الإجمالي (ج.م)"]
            ];

            let totalDirect = 0;
            let totalClient = 0;

            appState.boqItems.forEach((item, idx) => {
                const m = calculateItemMetrics(item);
                totalDirect += m.totalDirectCost;
                totalClient += m.totalClientPrice;
                boqRows.push([
                    idx + 1,
                    item.category,
                    item.name,
                    item.unit,
                    item.qty,
                    Number(m.directUnitCost.toFixed(2)),
                    item.profitPct,
                    Number(m.clientUnitPrice.toFixed(2)),
                    Number(m.totalClientPrice.toFixed(2))
                ]);
            });

            const vat = appState.meta.includeVat ? totalClient * 0.14 : 0;
            boqRows.push([]);
            boqRows.push(["", "", "إجمالي المقايسة قبل الضريبة", "", "", Number(totalDirect.toFixed(2)), "", "", Number(totalClient.toFixed(2))]);
            if (appState.meta.includeVat) {
                boqRows.push(["", "", "ضريبة القيمة المضافة (14%)", "", "", "", "", "", Number(vat.toFixed(2))]);
            }
            boqRows.push(["", "", "الإجمالي النهائي التعاقدي (جنيه مصري)", "", "", "", "", "", Number((totalClient + vat).toFixed(2))]);

            const wsBOQ = XLSX.utils.aoa_to_sheet(boqRows);
            wsBOQ['!cols'] = [{ wch: 6 }, { wch: 22 }, { wch: 48 }, { wch: 10 }, { wch: 12 }, { wch: 20 }, { wch: 12 }, { wch: 20 }, { wch: 22 }];
            XLSX.utils.book_append_sheet(wb, wsBOQ, "المقايسة (BOQ)");

            // Sheet 2: Rate Analysis
            const analysisRows = [
                ["SkyBuild — تحليل الأسعار واستهلاك الخامات ومعدلات الإنتاج"],
                [],
                ["رقم البند", "بيان البند", "الكمية", "الوحدة", "معدل الإنتاج/يوم", "أيام العمل", "الخامة / الطاقم", "معدل الاستهلاك", "الهالك %", "إجمالي الكمية", "سعر الوحدة", "إجمالي التكلفة"]
            ];

            appState.boqItems.forEach((item, idx) => {
                const m = calculateItemMetrics(item);
                analysisRows.push([
                    idx + 1, item.name, item.qty, item.unit, item.prodRate, Number(m.totalDaysNeeded.toFixed(2)),
                    `[عمالة] ${m.laborName}`, Number((1 / item.prodRate).toFixed(4)), 0,
                    Number(m.totalDaysNeeded.toFixed(2)), m.laborDailyRate, Number((m.totalDaysNeeded * m.laborDailyRate).toFixed(2))
                ]);
                m.breakdown.forEach(b => {
                    analysisRows.push([
                        idx + 1, item.name, item.qty, item.unit, item.prodRate, "",
                        `[خامة] ${b.name} (${b.unit})`, b.rate, b.waste,
                        Number(b.totalQtyNeeded.toFixed(2)), b.basePrice, Number(b.totalMatCost.toFixed(2))
                    ]);
                });
            });

            const wsAnalysis = XLSX.utils.aoa_to_sheet(analysisRows);
            wsAnalysis['!cols'] = [{ wch: 10 }, { wch: 40 }, { wch: 10 }, { wch: 10 }, { wch: 16 }, { wch: 14 }, { wch: 36 }, { wch: 16 }, { wch: 10 }, { wch: 16 }, { wch: 16 }, { wch: 18 }];
            XLSX.utils.book_append_sheet(wb, wsAnalysis, "تحليل الأسعار");

            // Sheet 3: Total Materials Take-off
            const matMap = {};
            appState.boqItems.forEach(item => {
                const m = calculateItemMetrics(item);
                m.breakdown.forEach(b => {
                    if (!matMap[b.matId]) matMap[b.matId] = { name: b.name, unit: b.unit, price: b.basePrice, qty: 0, cost: 0 };
                    matMap[b.matId].qty += b.totalQtyNeeded;
                    matMap[b.matId].cost += b.totalMatCost;
                });
            });

            const takeoffRows = [
                ["SkyBuild — بيان حصر الخامات والمشتريات المجمّع"],
                ["المشروع:", appState.meta.projectName],
                [],
                ["م", "اسم الخامة / المونة", "وحدة الشراء", "الكمية المطلوبة (شامل الهالك)", "سعر الوحدة (ج.م)", "إجمالي التكلفة (ج.م)"]
            ];

            let sumTakeoff = 0;
            Object.values(matMap).forEach((entry, idx) => {
                sumTakeoff += entry.cost;
                takeoffRows.push([idx + 1, entry.name, entry.unit, Number(entry.qty.toFixed(2)), entry.price, Number(entry.cost.toFixed(2))]);
            });
            takeoffRows.push([]);
            takeoffRows.push(["", "إجمالي تكلفة توريد الخامات", "", "", "", Number(sumTakeoff.toFixed(2))]);

            const wsTakeoff = XLSX.utils.aoa_to_sheet(takeoffRows);
            wsTakeoff['!cols'] = [{ wch: 6 }, { wch: 42 }, { wch: 14 }, { wch: 26 }, { wch: 20 }, { wch: 22 }];
            XLSX.utils.book_append_sheet(wb, wsTakeoff, "حصر الخامات");

            const fileName = `SkyBuild_مقايسة_${(appState.meta.projectName || "تشطيبات").replace(/[\\/:*?"<>|]/g, "_")}.xlsx`;
            XLSX.writeFile(wb, fileName);
            showToast("تم تصدير ملف Excel بنجاح!");
        }

        // JSON Backup & Restore
        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const a = document.createElement('a');
            a.setAttribute("href", dataStr);
            a.setAttribute("download", `SkyBuild_Backup_${appState.meta.date}.json`);
            document.body.appendChild(a);
            a.click();
            a.remove();
            showToast("تم حفظ نسخة احتياطية JSON");
        }

        function importJSON(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && parsed.boqItems) {
                        appState = parsed;
                        saveState();
                        initApp();
                        showToast("تم استعادة البيانات بنجاح");
                    }
                } catch (err) {
                    showToast("ملف JSON غير صالح", "error");
                }
            };
            reader.readAsText(file);
        }

        function showToast(message, type = "success") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === "error" ? "bg-rose-700" : type === "info" ? "bg-slate-800" : "bg-obsidian-950 border border-amber-500/40";
            toast.className = `${bgClass} text-white text-xs font-bold px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="ph ph-check-circle text-lg text-amber-400"></i><span>${message}</span>`;
            container.appendChild(toast);

            requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
