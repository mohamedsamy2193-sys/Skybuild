        function seedInitialBOQ() {
            const defaults = [
                { catId: "cat_plaster_int", qty: 280 },
                { catId: "cat_waterproof", qty: 16 },
                { catId: "cat_ceramic_floor", qty: 110 },
                { catId: "cat_ceramic_wall", qty: 65 },
                { catId: "cat_gypsum_flat", qty: 75 },
                { catId: "cat_paint_full", qty: 280 }
            ];
            defaults.forEach(d => {
                const cat = appState.catalog.find(c => c.id === d.catId);
                if (cat) appState.boqItems.push(createBOQInstance(cat, d.qty));
            });
            saveState();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
        }

        function createBOQInstance(catItem, qty) {
            return {
                uid: "boq_" + Date.now() + "_" + Math.random().toString(36).substr(2, 5),
                catalogId: catItem.id,
                category: catItem.category,
                name: catItem.name,
                unit: catItem.unit,
                qty: parseFloat(qty) || 1,
                profitPct: parseFloat(appState.meta.defaultProfit) || 0,
                prodRate: catItem.prodRate,
                laborId: catItem.laborId,
                materials: JSON.parse(JSON.stringify(catItem.materials))
            };
        }

