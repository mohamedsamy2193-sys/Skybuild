        function switchAppMode(mode) {
            const clientView = document.getElementById('view-client');
            const engView = document.getElementById('view-engineer');
            const btnClient = document.getElementById('btn-mode-client');
            const btnEng = document.getElementById('btn-mode-engineer');

            if (mode === 'client') {
                clientView.classList.remove('hidden');
                engView.classList.add('hidden');
                btnClient.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-obsidian-900 text-white shadow-xs";
                btnEng.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-silver-100 hover:bg-silver-200 text-obsidian-900 border border-silver-300";
            } else {
                clientView.classList.add('hidden');
                engView.classList.remove('hidden');
                btnEng.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-obsidian-900 text-white shadow-xs";
                btnClient.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition bg-silver-100 hover:bg-silver-200 text-obsidian-900 border border-silver-300";
                renderEngineerAll();
            }
        }

        function handleEngineerModeClick() {
            if (isEngineerUnlocked) {
                switchAppMode('engineer');
            } else {
                document.getElementById('login-pin-input').value = '';
                document.getElementById('login-modal').classList.remove('hidden');
                setTimeout(() => document.getElementById('login-pin-input').focus(), 100);
            }
        }

        function closeLoginModal() {
            document.getElementById('login-modal').classList.add('hidden');
        }

        function verifyEngineerLogin(e) {
            e.preventDefault();
            const entered = document.getElementById('login-pin-input').value;
            if (entered === appState.settings.engineerPin) {
                isEngineerUnlocked = true;
                document.getElementById('engineer-lock-icon').className = "ph ph-lock-key-open text-lg text-emerald-400";
                document.getElementById('engineer-btn-label').textContent = "لوحة المهندس";
                closeLoginModal();
                switchAppMode('engineer');
                showToast("مرحباً بك في لوحة المهندس — SkyBuild");
            } else {
                showToast("كلمة المرور غير صحيحة!", "error");
            }
        }

