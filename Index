        function calculateClientEstimate() {
            const area = Math.max(20, parseFloat(document.getElementById('client-area-input').value) || 140);
            const condition = document.getElementById('client-condition').value;
            const bathrooms = parseInt(document.getElementById('client-bathrooms').value) || 2;
            const rooms = parseInt(document.getElementById('client-rooms').value) || 4;
            const tierObj = FINISHING_TIERS.find(t => t.id === selectedClientTier) || FINISHING_TIERS[2];

            // Engineering Quantity Take-off Formulas based on Apartment Area
            const wallArea = Math.round(area * 2.45);
            const floorArea = Math.round(area * 0.92);
            const wetWallsArea = bathrooms * 24 + 18;
            const gypsumArea = Math.round(area * 0.55);
            const elecPoints = Math.round(area * 0.42) + bathrooms * 5;
            const doorsCount = rooms + bathrooms;
            const masonryArea = condition === 'red_brick' ? Math.round(area * 0.15) : Math.round(area * 0.08);

            // Base unit costs dynamically pulled from Engineer's live material/labor prices
            const getUnitRate = (catId) => {
                const cat = appState.catalog.find(c => c.id === catId);
                if (!cat) return 300;
                const m = calculateItemMetrics({ ...cat, qty: 1, profitPct: appState.meta.defaultProfit || 15 });
                return m.clientUnitPrice;
            };

            const lines = [];

            if (selectedClientPackages.has('pkg_masonry_plaster')) {
                const plasterFactor = condition === 'semi_finished' ? 0.25 : (condition === 'renovation' ? 0.55 : 1.0);
                const cost = (masonryArea * getUnitRate('cat_masonry_half') + wallArea * plasterFactor * getUnitRate('cat_plaster_int')) * (tierObj.multiplier * 0.95);
                lines.push({
                    pkg: "المباني والمحارة والتعديلات",
                    qtyText: `${wallArea} م² حوائط`,
                    cost: cost,
                    boqMapping: [
                        { catId: "cat_masonry_half", qty: masonryArea },
                        { catId: "cat_plaster_int", qty: Math.round(wallArea * plasterFactor) }
                    ]
                });
            }

            if (selectedClientPackages.has('pkg_plumbing_elec')) {
                const bathCost = bathrooms * getUnitRate('cat_plumbing_bath') + (bathrooms * 8 * getUnitRate('cat_waterproof'));
                const elecCost = elecPoints * getUnitRate('cat_elec_point') * 1.45; // rough + finish
                const totalPE = (bathCost + elecCost) * (tierObj.multiplier * 0.95);
                lines.push({
                    pkg: "السباكة والكهرباء والعزل",
                    qtyText: `${bathrooms} حمام + ${elecPoints} نقطة`,
                    cost: totalPE,
                    boqMapping: [
                        { catId: "cat_waterproof", qty: bathrooms * 8 },
                        { catId: "cat_plumbing_bath", qty: bathrooms },
                        { catId: "cat_elec_point", qty: elecPoints }
                    ]
                });
            }

            if (selectedClientPackages.has('pkg_flooring')) {
                const floorCat = (selectedClientTier === 'super_lux' || selectedClientTier === 'ultra_lux') ? 'cat_porcelain_floor' : 'cat_ceramic_floor';
                const cost = (floorArea * getUnitRate(floorCat) + wetWallsArea * getUnitRate('cat_ceramic_wall')) * (tierObj.multiplier * 0.95);
                lines.push({
                    pkg: "الأرضيات وسيراميك الحوائط",
                    qtyText: `${floorArea + wetWallsArea} م²`,
                    cost: cost,
                    boqMapping: [
                        { catId: floorCat, qty: floorArea },
                        { catId: "cat_ceramic_wall", qty: wetWallsArea }
                    ]
                });
            }

            if (selectedClientPackages.has('pkg_gypsum')) {
                const cost = gypsumArea * getUnitRate('cat_gypsum_flat') * tierObj.multiplier;
                lines.push({
                    pkg: "أسقف جبس بورد وإضاءة",
                    qtyText: `${gypsumArea} م²`,
                    cost: cost,
                    boqMapping: [
                        { catId: "cat_gypsum_flat", qty: gypsumArea }
                    ]
                });
            }

            if (selectedClientPackages.has('pkg_painting')) {
                const cost = wallArea * getUnitRate('cat_paint_full') * tierObj.multiplier;
                lines.push({
                    pkg: "الدهانات والديكورات",
                    qtyText: `${wallArea} م²`,
                    cost: cost,
                    boqMapping: [
                        { catId: "cat_paint_full", qty: wallArea }
                    ]
                });
            }

            if (selectedClientPackages.has('pkg_doors')) {
                const cost = doorsCount * getUnitRate('cat_wood_door') * (tierObj.multiplier * 0.92);
                lines.push({
                    pkg: "أبواب الغرف الداخلية",
                    qtyText: `${doorsCount} باب`,
                    cost: cost,
                    boqMapping: [
                        { catId: "cat_wood_door", qty: doorsCount }
                    ]
                });
            }

            const totalMid = lines.reduce((acc, l) => acc + l.cost, 0);
            const lowEst = Math.round((totalMid * 0.94) / 1000) * 1000;
            const highEst = Math.round((totalMid * 1.06) / 1000) * 1000;
            const perSqm = Math.round(totalMid / area);

            const minWeeks = Math.max(4, Math.round((area / 28) * (tierObj.multiplier * 0.9)));
            const maxWeeks = minWeeks + 2;

            document.getElementById('est-tier-label').textContent = `باقة ${tierObj.title} (${tierObj.en})`;
            document.getElementById('est-total-range').textContent = `${lowEst.toLocaleString('en-US')} — ${highEst.toLocaleString('en-US')} ج.م`;
            document.getElementById('est-per-sqm').textContent = `${perSqm.toLocaleString('en-US')} ج.م / م²`;
            document.getElementById('est-duration').textContent = `${minWeeks} إلى ${maxWeeks} أسبوع`;
            document.getElementById('est-active-count').textContent = `${lines.length} بنود رئيسية`;

            const tbody = document.getElementById('client-est-tbody');
            tbody.innerHTML = lines.map(l => `
                <tr>
                    <td class="py-2 px-3 font-bold text-white">${l.pkg}</td>
                    <td class="py-2 px-2 text-center text-slate-400">${l.qtyText}</td>
                    <td class="py-2 px-3 text-left font-bold text-amber-400">${Math.round(l.cost).toLocaleString('en-US')} ج.م</td>
                </tr>
            `).join('');

            lastClientEstimateSummary = {
                area,
                condition,
                bathrooms,
                rooms,
                tierTitle: tierObj.title,
                lowEst,
                highEst,
                lines
            };
        }

